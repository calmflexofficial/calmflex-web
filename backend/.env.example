# Keep these values on the server only. Never expose the secret in frontend files.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/orders.sqlite
NODE_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173
# For a separately hosted frontend over HTTPS, set COOKIE_SAME_SITE=None.
COOKIE_SAME_SITE=Lax
# Set to the hosting platform's trusted proxy hop count when applicable.
TRUST_PROXY=0
# Admin account is provisioned on server startup. Use a unique password of at least 14 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
